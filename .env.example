# ─────────────────────────────────────────────
# Copy this file to .env and fill in real values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_KEY=<service-role-key>

# API URLs — set to real domain in production
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEV_LAN_HOST=192.168.1.8
SITE_URL=http://localhost:3000

# Admin Panel
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Backend
PORT=4000
NODE_ENV=development
JWT_SECRET=<generate-with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))">

# PayU — use sandbox keys for development, live keys only on production host via secret manager
# Sandbox: https://test.payu.in | Live: https://secure.payu.in
PAYU_MODE=test
PAYU_KEY=<your-payu-key>
PAYU_SALT=<your-payu-salt>
PAYU_BASE_URL=https://test.payu.in
PAYU_SURL=https://<your-domain>/api/orders/payu/success
PAYU_FURL=https://<your-domain>/api/orders/payu/failure
PAYU_CLIENT_ID=<your-payu-client-id>
PAYU_CLIENT_SECRET=<your-payu-client-secret>
